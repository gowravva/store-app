# Copy this file to ".env" and fill in your real values.
# docker-compose reads .env automatically. NEVER commit the real .env.

# Public URL of the Store backend, as the BROWSER will reach it.
# Baked into the frontend at build time.
#   - local:        http://localhost:8001
#   - production:   http://<your-server-ip>:8001
VITE_API_URL=http://localhost:8001
