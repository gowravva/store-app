# systemd unit that keeps the FastAPI backend running (and restarts it on crash
# or server reboot). Installed to /etc/systemd/system/ by the deploy workflow.
[Unit]
Description=Store FastAPI backend
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/store-app/store-app/backend
ExecStart=/home/ec2-user/store-app/store-app/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
